{
  "policyVersion": "1.1.0",
  "enforcementMode": "block-new-unregistered-data-paths",
  "requiredArchitecture": [
    "permission-check",
    "service-layer",
    "smart-cache-for-offline-readable-data",
    "delta-sync-for-mutable-offline-readable-data",
    "offline-queue-for-supported-create-update",
    "user-and-scope-cache-isolation",
    "cache-invalidation-after-online-write",
    "runtime-and-static-certification"
  ],
  "domains": {
    "customers": {
      "file": "assets/js/customers-service.js",
      "mode": "full_offline_create_update",
      "status": "compliant"
    },
    "followups": {
      "file": "assets/js/followups-service.js",
      "mode": "full_offline_create_update",
      "status": "compliant"
    },
    "quotations": {
      "file": "assets/js/quotations-service.js",
      "mode": "full_offline_create_update",
      "status": "compliant"
    },
    "reference_data": {
      "file": "assets/js/reference-data-service.js",
      "mode": "offline_read_online_write",
      "status": "compliant"
    },
    "daily_operations": {
      "file": "assets/js/daily-operations-service.js",
      "mode": "full_offline_create_update",
      "status": "compliant"
    },
    "daily_alerts": {
      "file": "assets/js/daily-alerts-service.js",
      "mode": "offline_read_online_write",
      "status": "compliant"
    },
    "daily_suggestions": {
      "file": "assets/js/daily-suggestions-service.js",
      "mode": "offline_read_online_write",
      "status": "compliant"
    },
    "daily_activity": {
      "file": "assets/js/daily-activity-service.js",
      "mode": "offline_read_online_write",
      "status": "compliant"
    },
    "daily_performance": {
      "file": "assets/js/daily-performance-service.js",
      "mode": "offline_read_derived",
      "status": "compliant"
    },
    "users": {
      "file": "assets/js/users-service.js",
      "mode": "online_only_security_sensitive",
      "status": "accepted_online_only"
    },
    "permissions": {
      "file": "assets/js/permissions-service.js",
      "mode": "online_only_security_sensitive",
      "status": "accepted_online_only"
    },
    "system_settings": {
      "file": "assets/js/system-settings-service.js",
      "mode": "online_only_security_sensitive",
      "status": "accepted_online_only"
    },
    "activity_log": {
      "file": "assets/js/activity-service.js",
      "mode": "online_only_audit",
      "status": "accepted_online_only"
    },
    "backup": {
      "file": "assets/js/backup-service.js",
      "mode": "online_only_admin",
      "status": "accepted_online_only"
    },
    "system_health": {
      "file": "assets/js/system-health-service.js",
      "mode": "online_only_diagnostics",
      "status": "accepted_online_only"
    },
    "diagnostics": {
      "file": "assets/js/diagnostics-service.js",
      "mode": "online_only_diagnostics",
      "status": "accepted_online_only"
    },
    "whatsapp_templates": {
      "file": "assets/js/whatsapp-template-service.js",
      "mode": "online_only_user_media_settings",
      "status": "accepted_online_only"
    },
    "employee_report_settings": {
      "file": "assets/js/employee-report-settings-service.js",
      "mode": "online_only_admin_configuration",
      "status": "accepted_online_only"
    },
    "installation_requests": {
      "file": "assets/js/installations-service.js",
      "mode": "online_only_operational_setup",
      "status": "accepted_online_only"
    },
    "geographic_reference": {
      "file": "assets/js/geographic-address.js",
      "mode": "offline_read_online_refresh",
      "status": "compliant"
    },
    "advertising_reference_data": {
      "file": "assets/js/advertising-reference-service.js",
      "mode": "full_offline_create_update_delete",
      "status": "compliant"
    },
    "advertising_projects": {
      "file": "assets/js/advertising-projects-service.js",
      "mode": "full_offline_create_update_delete",
      "status": "compliant"
    },
    "advertising_inventory": {
      "file": "assets/js/advertising-inventory-service.js",
      "mode": "cached_reads_server_authoritative_posting",
      "status": "compliant",
      "notes": "Inventory reads are cached; balance-affecting posting/reversal requires server atomic RPC and is not queued offline."
    },
    "advertising_material_issue": {
      "file": "assets/js/advertising-material-service.js",
      "mode": "cached_reads_server_authoritative_posting",
      "status": "compliant",
      "notes": "Open projects, item balances and material history are cached. Issue/return/reversal must post through atomic server RPCs and are never locally balance-authoritative."
    },
    "advertising_custody": {
      "file": "assets/js/advertising-custody-service.js",
      "mode": "cached_reads_server_authoritative_posting",
      "status": "compliant",
      "notes": "Custody balances/history are cached; receiving, returning, settling and direct-project spending require atomic server posting."
    },
    "advertising_purchases": {
      "file": "assets/js/advertising-purchases-service.js",
      "mode": "cached_reads_server_authoritative_posting",
      "status": "compliant",
      "notes": "Purchase history/reference reads are cached; posting/reversal stays atomic server-side across inventory, custody and project cost."
    },
    "advertising_project_expenses": {
      "file": "assets/js/advertising-expenses-service.js",
      "mode": "cached_reads_server_authoritative_posting",
      "status": "compliant",
      "notes": "Expense history/reference reads are cached; posting and reversal are atomic server operations across project cost and custody."
    },
    "advertising_project_profitability": {
      "file": "assets/js/advertising-profitability-service.js",
      "mode": "cached_reads_server_authoritative_financial_close",
      "status": "compliant",
      "notes": "Profitability reads are cached; close/reopen remain server-authoritative and auditable."
    },
    "advertising_reporting": {
      "file": "assets/js/advertising-reporting-service.js",
      "mode": "cached_readonly_reports",
      "status": "compliant",
      "notes": "Dashboard and report snapshots come from permission-checked canonical server RPCs and are cached for offline reading."
    }
  },
  "registeredDirectDataFiles": [
    "assets/js/activity-service.js",
    "assets/js/advertising-reference-service.js",
    "assets/js/app.js",
    "assets/js/auth-session.js",
    "assets/js/backup-service.js",
    "assets/js/customers-service.js",
    "assets/js/daily-activity-service.js",
    "assets/js/daily-alerts-service.js",
    "assets/js/daily-operations-service.js",
    "assets/js/daily-performance-service.js",
    "assets/js/daily-suggestions-service.js",
    "assets/js/diagnostics-service.js",
    "assets/js/employee-report-settings-service.js",
    "assets/js/followups-service.js",
    "assets/js/geographic-address.js",
    "assets/js/installations-service.js",
    "assets/js/offline-queue.js",
    "assets/js/offline-read-cache.js",
    "assets/js/permissions-service.js",
    "assets/js/quotations-service.js",
    "assets/js/reference-data-service.js",
    "assets/js/smart-cache.js",
    "assets/js/supabase-client.js",
    "assets/js/supabase-config.js",
    "assets/js/sync-engine.js",
    "assets/js/system-health-service.js",
    "assets/js/system-settings-service.js",
    "assets/js/users-service.js",
    "assets/js/whatsapp-template-service.js",
    "assets/js/advertising-projects-service.js",
    "assets/js/advertising-inventory-service.js",
    "assets/js/advertising-material-service.js",
    "assets/js/advertising-custody-service.js",
    "assets/js/advertising-purchases-service.js",
    "assets/js/advertising-expenses-service.js",
    "assets/js/advertising-profitability-service.js",
    "assets/js/advertising-reporting-service.js"
  ],
  "temporaryDirectUiDebt": {
    "assets/js/app.js": [
      "sales_representatives update",
      "sales_representatives delete",
      "generic reference delete"
    ]
  },
  "rulesForFutureFeatures": {
    "newDataServiceMustBeRegistered": true,
    "newOfflineReadableDomainMustUseSmartCache": true,
    "newMutableOfflineReadableDomainMustUseDeltaSync": true,
    "newOfflineCreateUpdateMustUseOfflineQueue": true,
    "directSupabaseCallsFromUiAreForbidden": true,
    "offlineDeleteRequiresExplicitDesignAndTombstoneStrategy": true,
    "securitySensitiveAdminWritesRemainOnlineOnlyUnlessSeparatelyApproved": true
  }
}
